<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="{{ page.description }}" />
    <title>{{ page.title }} — {{ site.name }}</title>
  </head>
  <body class="theme-{{ page.theme or 'beige' }}{% if page.bodyClass %} {{ page.bodyClass }}{% endif %}">
    {% include "components/icon-sprite/icon-sprite.njk" %}
    {% include "components/site-header/site-header.njk" %}
    <main class="page">
      {% block content %}{% endblock %}
    </main>
    {% include "components/site-footer/site-footer.njk" %}
    {% include "components/cookie-consent/cookie-consent.njk" %}
    <script type="module" src="/src/main.ts"></script>
  </body>
</html>
