{% from "components/modal/modal.njk" import modal %}
{% from "components/icon/icon.njk" import icon %}
{% from "components/request-form/request-form.njk" import requestForm with context %}
{% macro bookingModal(booking, config) %}
{% call modal(booking.modalId, booking.title, config.closeLabel, 'booking-modal') %}
  <div class="booking-modal__card">
    <div class="booking-modal__media">
      <img class="booking-modal__image" src="{{ booking.image }}" alt="{{ booking.imageAlt }}" loading="lazy" />
      {% if booking.duration %}<span class="booking-modal__duration">{{ booking.duration }}</span>{% endif %}
      <button class="booking-modal__desktop-close" type="button" aria-label="{{ config.closeLabel }}" data-modal-close>{{ icon('booking-close', '', 3.6) }}</button>
    </div>
    <div class="booking-modal__intro">
      <h2 class="booking-modal__title">{{ booking.title }}</h2>
      {% if booking.description %}<p class="booking-modal__description">{{ booking.description }}</p>{% endif %}
    </div>
    {% if booking.facts %}
    <dl class="booking-modal__facts">
      {% for fact in booking.facts %}
      <div class="booking-modal__fact{% if fact.text %} booking-modal__fact--text{% endif %}">
        <dt>{{ fact.label }}</dt>
        <dd>{% if fact.lines %}{% for line in fact.lines %}<span class="booking-modal__fact-line">{{ line }}</span>{% if not loop.last %} {% endif %}{% endfor %}{% else %}{{ fact.value }}{% endif %}</dd>
      </div>
      {% endfor %}
    </dl>
    {% endif %}
    {{ requestForm(config.form, booking.modalId ~ '-request') }}
  </div>
{% endcall %}
{% endmacro %}
{% for booking in page.bookingModals.items %}
  {{ bookingModal(booking, page.bookingModals) }}
{% endfor %}
