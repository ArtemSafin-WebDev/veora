{% from "components/button/button.njk" import button %}
{% from "components/slider-arrows/slider-arrows.njk" import sliderArrows %}
<article class="room-card{% if page.rooms.cardVariant %} room-card--{{ page.rooms.cardVariant }}{% endif %}" aria-labelledby="room-{{ room.id }}-title">
  <div class="room-card__content">
    <div class="room-card__description">
      <h3 class="room-card__title" id="room-{{ room.id }}-title">{% for line in room.titleLines %}{{ line }}{% if not loop.last %}<br />{% endif %}{% endfor %}</h3>
      <div class="room-card__stats{% if room.mobileStats %} room-card__stats--desktop{% endif %}">
        {% for stat in room.stats %}<span class="room-card__stat">{{ stat }}{% if not loop.last %}<span class="room-card__separator" aria-hidden="true">|</span>{% endif %}</span>{% endfor %}
      </div>
      {% if room.mobileStats %}<div class="room-card__stats room-card__stats--mobile">
        {% for stat in room.mobileStats %}<span class="room-card__stat">{{ stat }}{% if not loop.last %}<span class="room-card__separator" aria-hidden="true">|</span>{% endif %}</span>{% endfor %}
      </div>{% endif %}
    </div>
    <div class="room-card__actions">
      {{ button(page.rooms.bookingLabel, room.bookingHref, 'room-card__booking', 'primary' if page.rooms.cardVariant in ['catalog', 'related'] else 'base', true, true) }}
      {{ button(page.rooms.detailsLabel, room.href, 'room-card__details', 'detail', true, true) }}
    </div>
  </div>
  <div class="room-card__gallery{% if not loop.first and not page.rooms.mobileGalleryControls %} room-card__gallery--desktop-controls{% endif %}" data-room-gallery>
    <div class="room-card__slider swiper" aria-label="{{ room.title }}">
      <div class="swiper-wrapper">
        {% for photo in room.images %}<div class="room-card__slide swiper-slide"><img class="room-card__image" src="{{ photo.src }}" alt="{{ photo.alt }}" loading="lazy" /></div>{% endfor %}
      </div>
    </div>
    {% if room.images.length > 1 %}
      {{ sliderArrows(page.rooms.previousLabel, page.rooms.nextLabel, 'room-card__arrows') }}
    {% endif %}
  </div>
</article>
