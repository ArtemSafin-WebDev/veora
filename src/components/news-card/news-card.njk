{% from "components/button/button.njk" import button %}
<a class="news-card{% if newsCardVariant %} news-card--{{ newsCardVariant }}{% endif %}{% if card.catalog %} news-card--catalog{% endif %}" href="{{ card.href }}"{% if card.resorts %} data-catalog-resorts="{{ card.resorts | join(' ') }}"{% endif %}>
  <div class="news-card__inner">
    <div class="news-card__meta">
      <span class="news-card__label">{% if card.mobileCategory %}<span class="news-card__desktop">{{ card.category }}</span><span class="news-card__mobile">{{ card.mobileCategory }}</span>{% else %}{{ card.category }}{% endif %}</span>
      <time class="news-card__date" datetime="{{ card.date }}">{{ card.dateLabel }}</time>
    </div>
    <div class="news-card__content">
      <h3 class="news-card__title">{% if card.mobileTitle %}<span class="news-card__desktop">{% endif %}{% if card.titleLines %}{% for line in card.titleLines %}{% if not loop.first %}<br />{% endif %}{{ line }}{% endfor %}{% else %}{{ card.title }}{% endif %}{% if card.mobileTitle %}</span><span class="news-card__mobile">{{ card.mobileTitle }}</span>{% endif %}</h3>
      {{ button(card.readMoreLabel or page.news.readMoreLabel, null, 'news-card__link', 'muted') }}
    </div>
  </div>
</a>
