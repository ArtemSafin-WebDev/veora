{% from "components/button/button.njk" import button %}
<a class="news-card{% if card.catalog %} news-card--catalog{% endif %}" href="{{ card.href }}"{% if card.resorts %} data-catalog-resorts="{{ card.resorts | join(' ') }}"{% endif %}>
  <div class="news-card__inner">
    <div class="news-card__meta">
      <span class="news-card__label">{{ card.category }}</span>
      <time class="news-card__date" datetime="{{ card.date }}">{{ card.dateLabel }}</time>
    </div>
    <div class="news-card__content">
      <h3 class="news-card__title">{% if card.titleLines %}{% for line in card.titleLines %}{% if not loop.first %}<br />{% endif %}{{ line }}{% endfor %}{% else %}{{ card.title }}{% endif %}</h3>
      {{ button(card.readMoreLabel or page.news.readMoreLabel, null, 'news-card__link', 'muted') }}
    </div>
  </div>
</a>
