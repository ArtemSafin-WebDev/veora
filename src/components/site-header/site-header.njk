<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href="/" aria-label="{{ site.brand.ariaLabel }}">{{ site.brand.text }}<span class="site-header__brand-accent">{{ site.brand.suffix }}</span></a>
    <nav class="site-header__nav" aria-label="{{ site.navigationLabel }}">
      {% for item in site.navigation %}
        <a class="site-header__link" href="{{ item.href }}"{% if item.id == page.activePage %} aria-current="page"{% endif %}>{{ item.label }}</a>
      {% endfor %}
    </nav>
  </div>
</header>
