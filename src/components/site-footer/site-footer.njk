{% from "components/icon/icon.njk" import icon %}
{% set footerPage = page.footer or {} %}
<footer class="site-footer{% if footerPage.variant %} site-footer--{{ footerPage.variant }}{% endif %}{% if footerPage.compactNavigation %} site-footer--compact-navigation{% endif %}">
  <div class="site-footer__surface">
    <div class="site-footer__inner container">
      <a class="site-footer__mark" href="{{ footerPage.homeHref or '/' }}" aria-label="{{ site.brand.ariaLabel }}">
        {{ icon('footer-brand-mark', 'site-footer__mark-desktop', 6.5, 6.2) }}
        {{ icon(footerPage.mobileMark or 'footer-brand-mark-mobile', 'site-footer__mark-mobile', 4.81678, 4.54154) }}
      </a>

      <div class="site-footer__brand" aria-label="Веора">
        {{ icon('footer-brand-heading', 'site-footer__brand-desktop', 128.4, 3.2) }}
        {{ icon(footerPage.mobileWordmark or 'footer-wordmark', 'site-footer__brand-mobile', 11.1, 3.2) }}
      </div>

      <div class="site-footer__main">
        <nav class="site-footer__navigation" aria-label="Навигация в подвале">
          {% for group in footerPage.navigation or site.footer.navigation %}
            <div class="site-footer__nav-group">
              <h2 class="site-footer__label">{{ group.title }}</h2>
              <ul class="site-footer__links">
                {% for link in group.links %}
                  <li><a href="{{ link.href }}">{% if link.mobileLabel %}<span class="site-footer__desktop-label">{{ link.label }}</span><span class="site-footer__mobile-label">{{ link.mobileLabel }}</span>{% else %}{{ link.label }}{% endif %}</a></li>
                {% endfor %}
              </ul>
            </div>
          {% endfor %}
        </nav>

        <div class="site-footer__actions">
          <div class="site-footer__booking">
            {% for item in site.footer.booking %}
              <a class="site-footer__booking-card site-footer__booking-card--{{ item.variant }}" href="{{ item.href }}">
                <span class="site-footer__booking-title">{{ item.title }}</span>
                <span class="site-footer__booking-cta">{% if footerPage.mobileBookingLabel %}<span class="site-footer__desktop-label">{{ footerPage.bookingLabel or item.cta }}</span><span class="site-footer__mobile-label">{{ footerPage.mobileBookingLabel }}</span>{% else %}{{ footerPage.bookingLabel or item.cta }}{% endif %}</span>
              </a>
            {% endfor %}
          </div>
          <div class="site-footer__socials" aria-label="Мессенджеры">
            {% for item in site.footer.socials %}
              <a class="site-footer__social-link" href="{{ item.href }}" aria-label="{{ item.label }}" rel="noopener noreferrer" target="_blank">
                <svg class="site-footer__social-icon" aria-hidden="true" focusable="false" viewBox="0 0 40 40">
                  <use href="#icon-{{ item.icon }}"></use>
                </svg>
              </a>
            {% endfor %}
          </div>
        </div>
      </div>

      <div class="site-footer__details">
        <div class="site-footer__detail site-footer__detail--address">
          <h2 class="site-footer__label">{{ site.footer.address.label }}</h2>
          <p class="site-footer__detail-value">{{ site.footer.address.value }}</p>
        </div>
        <div class="site-footer__detail site-footer__detail--hours">
          <h2 class="site-footer__label">{{ site.footer.hours.label }}</h2>
          <p class="site-footer__detail-value">{{ site.footer.hours.days }}<br>{{ site.footer.hours.time }}</p>
        </div>
        <div class="site-footer__detail site-footer__detail--contacts">
          <h2 class="site-footer__label">{{ site.footer.contacts.label }}</h2>
          <div class="site-footer__phone">
            <a class="site-footer__detail-value" href="{{ site.footer.contacts.phoneHref }}">{{ site.footer.contacts.phone }}</a>
            <a class="site-footer__callback" href="{{ site.footer.contacts.callbackHref }}">{{ site.footer.contacts.callbackLabel }}</a>
          </div>
          <a class="site-footer__detail-value site-footer__email" href="mailto:{{ site.footer.contacts.email }}">{{ site.footer.contacts.email }}</a>
        </div>
      </div>

      <div class="site-footer__bottom">
        <p class="site-footer__copyright">© <span{% if not footerPage.copyrightYear %} data-current-year{% endif %}>{{ footerPage.copyrightYear or currentYear }}</span> — {{ site.footer.copyrightIntro }} <span>{{ site.footer.copyrightOrganization }}</span></p>
        <a class="site-footer__privacy" href="{{ site.footer.privacy.href }}">{{ site.footer.privacy.label }}</a>
        <span class="site-footer__credit">
          <img src="{{ footerPage.creditImage or '/assets/footer/creative-team.svg' }}" alt="{{ site.footer.credit.label }}" width="120" height="26">
        </span>
      </div>
    </div>
  </div>
</footer>
