{% from "components/modal/modal.njk" import modal %}
{% from "components/icon/icon.njk" import icon %}
{% from "components/request-form/request-form.njk" import requestForm with context %}
{% for treatment in page.cosmetologyTreatments %}
{% call modal(treatment.modalId, treatment.title, page.cosmetology.closeLabel, 'booking-modal cosmetology-modal') %}
  <div class="booking-modal__card{% if not treatment.image %} cosmetology-modal__text-card{% endif %}">
    {% if treatment.image %}<div class="booking-modal__media">
      <img class="booking-modal__image" src="{{ treatment.image }}" alt="{{ treatment.imageAlt }}" loading="lazy" />
      {% if treatment.duration %}<span class="booking-modal__duration">{{ treatment.duration }}</span>{% endif %}
      <button class="booking-modal__desktop-close" type="button" aria-label="{{ page.cosmetology.closeLabel }}" data-modal-close>{{ icon('booking-close', '', 3.6) }}</button>
    </div>{% else %}
    <button class="booking-modal__desktop-close cosmetology-modal__text-close" type="button" aria-label="{{ page.cosmetology.closeLabel }}" data-modal-close>{{ icon('booking-close', '', 3.6) }}</button>
    {% endif %}
    <div class="booking-modal__intro">
      <h2 class="booking-modal__title">{{ treatment.title }}</h2>
      {% if treatment.description %}<p class="booking-modal__description">{{ treatment.description }}</p>{% endif %}
    </div>
    {% if treatment.facts %}
    <dl class="cosmetology-modal__facts">
      {% for fact in treatment.facts %}
      <div class="cosmetology-modal__fact{% if fact.text %} cosmetology-modal__fact--text{% endif %}">
        <dt>{{ fact.label }}</dt>
        <dd>{% if fact.lines %}{% for line in fact.lines %}<span class="cosmetology-modal__fact-line">{{ line }}</span>{% if not loop.last %} {% endif %}{% endfor %}{% else %}{{ fact.value }}{% endif %}</dd>
      </div>
      {% endfor %}
    </dl>
    {% endif %}
    {{ requestForm(page.cosmetology.form, treatment.modalId ~ '-request') }}
  </div>
{% endcall %}
{% endfor %}
