{% from "components/icon/icon.njk" import icon %}
{% macro resortNavigation(config) %}
<div class="resort-navigation{% if config.variant %} resort-navigation--{{ config.variant }}{% endif %}" data-resort-navigation{% if config.links %} data-navigation-param="{{ config.parameter or 'category' }}"{% endif %}>
  <button class="resort-navigation__trigger" type="button" data-modal-open="{{ config.id }}-modal" aria-haspopup="dialog" aria-controls="{{ config.id }}-modal"><span>{{ config.filtersLabel }}</span><span class="resort-navigation__caption">{{ config.triggerLabel }}</span></button>
  <div class="resort-navigation__desktop" data-resort-navigation-desktop>
    {% if config.links %}
    <nav class="resort-navigation__form" aria-label="{{ config.label }}" data-resort-navigation-form>
      {% for item in config.items %}
        <a class="resort-navigation__text resort-navigation__link" href="{{ item.href }}" data-navigation-value="{{ item.value }}"{% if loop.first %} aria-current="page"{% endif %}>{% if item.labelLines %}{% for line in item.labelLines %}{{ line }}{% if not loop.last %} <br class="resort-navigation__mobile-break" />{% endif %}{% endfor %}{% else %}{{ item.label }}{% endif %}</a>
      {% endfor %}
    </nav>
    {% else %}
    <form class="resort-navigation__form" aria-label="{{ config.label }}" data-resort-navigation-form>
      {% for item in config.items %}
        <label class="resort-navigation__option{% if item.desktopOnly %} resort-navigation__option--desktop-only{% endif %}"><input class="resort-navigation__input" type="radio" name="resort" value="{{ item.value }}"{% if item.value == config.selectedValue or (not config.selectedValue and loop.first) %} checked{% endif %} /><span class="resort-navigation__text">{{ item.label }}</span></label>
      {% endfor %}
    </form>
    {% endif %}
  </div>
  <dialog class="resort-navigation__modal" id="{{ config.id }}-modal" aria-label="{{ config.filtersLabel }}" data-modal>
    <button class="resort-navigation__close" type="button" data-modal-close aria-label="{{ config.closeLabel }}" autofocus>{{ icon('modal-close', 'resort-navigation__close-icon', 3) }}</button>
    <div class="resort-navigation__sheet" data-resort-navigation-mobile></div>
  </dialog>
</div>
{% endmacro %}
