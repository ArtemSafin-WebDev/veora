{% from "components/icon/icon.njk" import icon %}
<section class="hero{% if page.hero.variant %} hero--{{ page.hero.variant }}{% endif %}{% if page.hero.detailVariant %} hero--{{ page.hero.detailVariant }}{% endif %}" aria-labelledby="hero-title">
  <div class="hero__stage">
    <div class="hero__visual" aria-hidden="true">
      <picture class="hero__picture">
        {% if page.hero.mobileImage %}<source media="(max-width: 600px)" srcset="{{ page.hero.mobileImage }}" />{% endif %}
        <img class="hero__image" src="{{ page.hero.image }}" alt="" />
      </picture>
    </div>
    {% if page.hero.backLink %}
      <a class="hero__back-link" href="{{ page.hero.backLink.href }}">
        {{ icon(page.hero.backLink.icon, '', 1.3) }}
        <span>{{ page.hero.backLink.label }}</span>
      </a>
    {% endif %}
    <div class="hero__lead container">
      {% if page.hero.breadcrumbs %}
        {% from "components/breadcrumbs/breadcrumbs.njk" import breadcrumbs %}
        <div class="hero__breadcrumbs">{{ breadcrumbs(page.hero.breadcrumbs, page.hero.breadcrumbsLabel) }}</div>
      {% endif %}
      <h1 class="hero__title" id="hero-title">{% if page.hero.titleLines %}{% for line in page.hero.titleLines %}<span class="hero__title-line">{{ line }}</span>{% if not loop.last %} {% endif %}{% endfor %}{% else %}{{ page.hero.title }}{% endif %}</h1>
      {% if page.hero.features %}
        <ul class="hero__features">
          {% for feature in page.hero.features %}<li>{{ feature }}</li>{% endfor %}
        </ul>
      {% endif %}
      {% from "components/booking-search/booking-search.njk" import bookingSearch %}
      {{ bookingSearch(page.hero.booking, site.footer.booking) }}
    </div>
  </div>
  <div class="hero__details">
    <div class="hero__brand-row container" aria-hidden="true">
      <span class="hero__divider">{{ icon(page.hero.divider, 'hero__divider-desktop', 40, 0.1) }}{{ icon(page.hero.dividerMobile, 'hero__divider-mobile', 8, 0.1) }}</span>
      <span class="hero__mark">{{ icon(page.hero.brandMark, 'hero__mark-desktop', 13.1, 12.3) }}{{ icon(page.hero.brandMarkMobile, 'hero__mark-mobile', 7.22518, 6.81231) }}</span>
      <span class="hero__divider">{{ icon(page.hero.divider, 'hero__divider-desktop', 40, 0.1) }}{{ icon(page.hero.dividerMobile, 'hero__divider-mobile', 8, 0.1) }}</span>
    </div>
    <p class="hero__description">{{ page.hero.description }}</p>
    {% if page.hero.text %}<p class="hero__text">{{ page.hero.text }}</p>{% endif %}
    {% if page.hero.stats %}
    <div class="hero__stats" aria-label="{{ page.hero.statsLabel }}">
      {% for stat in page.hero.stats %}
        <div class="hero__stat">
          <strong class="hero__stat-number">{{ stat.value }}</strong>
          <span class="hero__stat-label">{{ stat.label }}</span>
        </div>
      {% endfor %}
    </div>
    {% endif %}
    {% if page.hero.specifications %}
      <dl class="hero__specifications">
        {% for spec in page.hero.specifications %}
          <div class="hero__specification">
            <dt><img class="hero__specification-icon" src="{{ spec.icon }}" alt="" /><span>{{ spec.label }}</span></dt>
            <dd>{{ spec.value }}</dd>
          </div>
        {% endfor %}
      </dl>
    {% endif %}
  </div>
</section>
