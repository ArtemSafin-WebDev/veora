{% from "components/icon/icon.njk" import icon %}
<section class="intro" aria-label="{{ page.intro.logoAlt }}">
  <video class="intro__video" poster="{{ page.intro.image }}" autoplay muted loop playsinline preload="metadata" aria-hidden="true">
    <source src="{{ page.intro.video }}" type="video/mp4" />
  </video>
  <div class="intro__overlay" aria-hidden="true"></div>
  <div class="intro__brand">
    <img class="intro__logo" src="{{ page.intro.logo }}" alt="{{ page.intro.logoAlt }}" />
  </div>
  <a class="intro__next" href="{{ page.intro.nextHref }}" aria-label="{{ page.intro.nextLabel }}">
    {{ icon('scroll-next', 'intro__next-icon', 4) }}
  </a>
</section>
