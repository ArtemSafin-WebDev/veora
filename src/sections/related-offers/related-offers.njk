{% from "components/section-title/section-title.njk" import sectionTitle %}
{% from "components/button/button.njk" import button %}
{% set related = page.relatedOffers %}
<section class="related-offers container" aria-labelledby="{{ related.id }}-title">
  <div class="related-offers__header">
    {{ sectionTitle(related.title, related.id + '-title', 'related-offers__title') }}
    {% if related.allLink %}{{ button(related.allLink.label, related.allLink.href, 'related-offers__all-link', 'light', true, true) }}{% endif %}
  </div>
  <div class="related-offers__slider swiper" data-related-offers-slider>
    <div class="related-offers__track swiper-wrapper">
      {% for offer in related.items %}
      <div class="related-offers__slide swiper-slide">
        {% include "components/offer-card/offer-card.njk" %}
      </div>
      {% endfor %}
    </div>
  </div>
  {% if related.allLink %}{{ button(related.allLink.label, related.allLink.href, 'related-offers__mobile-link') }}{% endif %}
</section>
