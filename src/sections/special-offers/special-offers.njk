{% from "components/button/button.njk" import button %}
{% from "components/section-title/section-title.njk" import sectionTitle %}
<section class="special-offers{% if page.specialOffers.variant %} special-offers--{{ page.specialOffers.variant }}{% endif %} container" id="special-offers" aria-labelledby="special-offers-title">
  {% set specialOffers = page.specialOffers %}
  {% set offerCardVariant = specialOffers.variant %}
  <div class="special-offers__header">
    {{ sectionTitle(specialOffers.title, 'special-offers-title', 'special-offers__title') }}
    {{ button(specialOffers.allLink.label, specialOffers.allLink.href, 'special-offers__all-link', 'dark') }}
  </div>
  <div class="special-offers__slider swiper" data-offers-slider>
    <div class="special-offers__track swiper-wrapper">
      {% for offer in specialOffers.items %}
        <div class="special-offers__slide swiper-slide">
          {% include "components/offer-card/offer-card.njk" %}
        </div>
      {% endfor %}
    </div>
  </div>
  {{ button(specialOffers.allLink.label, specialOffers.allLink.href, 'special-offers__mobile-link', 'dark') }}
</section>
