{% from "components/catalog-layout/catalog-layout.njk" import catalogLayout %}
{% call catalogLayout(page.catalog.navigation, 'gallery-catalog', page.catalog.label, 'compact') %}
  <div class="gallery-catalog__grid" aria-live="polite">
    {% for card in page.gallery.items %}
      {% include "components/gallery-card/gallery-card.njk" %}
    {% endfor %}
  </div>
  <p class="gallery-catalog__empty" data-catalog-empty hidden>{{ page.catalog.emptyLabel }}</p>
{% endcall %}
