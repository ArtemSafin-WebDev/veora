{% from "components/breadcrumbs/breadcrumbs.njk" import breadcrumbs %}
{% from "components/icon/icon.njk" import icon %}
{% macro newsIntro(intro, titleId='news-detail-title') %}
<section class="news-intro container" aria-labelledby="{{ titleId }}" data-news-intro>
  {{ breadcrumbs(intro.breadcrumbs, intro.breadcrumbsLabel) }}
  <div class="news-intro__content">
    <div class="news-intro__meta">
      {% if intro.place %}<span class="news-intro__place">{{ intro.place }}</span>{% endif %}
      {% if intro.period %}<p class="news-intro__period">{{ intro.period }}</p>{% endif %}
      <div class="news-intro__tools">
        <button class="news-intro__tool" type="button" aria-label="{{ intro.shareLabel }}" data-news-share>{{ icon('offer-share') }}</button>
        <button class="news-intro__tool" type="button" aria-label="{{ intro.printLabel }}" data-news-print>{{ icon('offer-print') }}</button>
      </div>
    </div>
    <h1 class="news-intro__title" id="{{ titleId }}">{% if intro.titleLines.length %}{% for line in intro.titleLines %}{{ line }}{% if not loop.last %}<br />{% endif %}{% endfor %}{% else %}{{ intro.title }}{% endif %}</h1>
    {% if intro.image %}
    <picture class="news-intro__media">
      {% if intro.mobileImage %}<source media="(max-width: 600px)" srcset="{{ intro.mobileImage }}" />{% endif %}
      <img class="news-intro__image" src="{{ intro.image }}" alt="{{ intro.imageAlt }}" fetchpriority="high" />
    </picture>
    {% endif %}
    <p class="news-intro__status" role="status" data-news-status hidden data-copied-message="{{ intro.copiedMessage }}" data-share-error="{{ intro.shareError }}"></p>
  </div>
</section>
{% endmacro %}
{{ newsIntro(page.newsIntro) }}
