{% from "components/breadcrumbs/breadcrumbs.njk" import breadcrumbs %}
{% from "components/icon/icon.njk" import icon %}
{% set detail = page.legalDetail %}
<section class="legal-detail" aria-labelledby="legal-detail-title">
  <div class="legal-detail__breadcrumbs">
    {{ breadcrumbs(detail.breadcrumbs, detail.breadcrumbsLabel) }}
  </div>
  <div class="legal-detail__content">
    <div class="legal-detail__header">
      <h1 class="legal-detail__title" id="legal-detail-title">{{ detail.title }}</h1>
      {% if detail.download and detail.download.href %}
      <a class="legal-detail__download" href="{{ detail.download.href }}" download="{{ detail.download.filename }}">
        {{ icon('legal-download') }}
        <span>{{ detail.download.label }}</span>
      </a>
      {% endif %}
    </div>
    {# Trusted editor HTML maps to Bitrix DETAIL_TEXT. #}
    <div class="legal-detail__body">{{ detail.html | safe }}</div>
  </div>
</section>
