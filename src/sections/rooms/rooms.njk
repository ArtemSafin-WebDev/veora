{% from "components/button/button.njk" import button %}
{% from "components/section-title/section-title.njk" import sectionTitle %}
<section class="rooms container" id="rooms" aria-labelledby="rooms-title">
  <div class="rooms__header">
    {{ sectionTitle(page.rooms.title, 'rooms-title', 'rooms__title') }}
    <span class="rooms__divider" aria-hidden="true"></span>
    {{ button(page.rooms.allLink.label, page.rooms.allLink.href, 'rooms__all-link', 'dark', true, true) }}
  </div>
  <div class="rooms__list" id="rooms-list">
    {% for room in page.rooms.items %}
      {% include "components/room-card/room-card.njk" %}
    {% endfor %}
  </div>
</section>
