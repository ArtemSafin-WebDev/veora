{% from "components/section-title/section-title.njk" import sectionTitle %}
{% from "components/button/button.njk" import button %}
{% set related = page.relatedNews %}
<section class="related-news container" aria-labelledby="{{ related.id }}-title">
  <div class="related-news__header">
    {{ sectionTitle(related.title, related.id + '-title', 'related-news__title') }}
    {% if related.allLink %}{{ button(related.allLink.label, related.allLink.href, 'related-news__all-link') }}{% endif %}
  </div>
  <div class="related-news__slider swiper" data-related-news-slider>
    <div class="related-news__track swiper-wrapper">
      {% for card in related.items %}
      <div class="related-news__slide swiper-slide">
        {% include "components/news-card/news-card.njk" %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>
