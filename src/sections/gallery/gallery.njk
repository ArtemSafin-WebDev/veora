{% from "components/button/button.njk" import button %}
{% from "components/slider-arrows/slider-arrows.njk" import sliderArrows %}
{% from "components/section-title/section-title.njk" import sectionTitle %}
<section class="gallery{% if page.gallery.variant %} gallery--{{ page.gallery.variant }}{% endif %} container" id="gallery" data-gallery data-gallery-modal="{{ page.gallery.modal.id }}" aria-labelledby="gallery-title">
  <div class="gallery__header">
    {{ sectionTitle(page.gallery.title, 'gallery-title', 'gallery__title') }}
    <span class="gallery__divider" aria-hidden="true"></span>
    <div class="gallery__controls">
      {% if page.gallery.allLink %}{{ button(page.gallery.allLink.label, page.gallery.allLink.href, 'gallery__all-link', 'gallery') }}{% endif %}
      {{ sliderArrows(page.gallery.modal.previousLabel, page.gallery.modal.nextLabel, 'gallery__arrows') }}
    </div>
  </div>

  <div class="gallery__slider swiper">
    <div class="gallery__track swiper-wrapper">
      {% set galleryCardVariant = page.gallery.variant %}
      {% for card in page.gallery.items %}
        <div class="gallery__slide swiper-slide">
          {% include "components/gallery-card/gallery-card.njk" %}
        </div>
      {% endfor %}
    </div>
  </div>
  {% if page.gallery.allLink %}{{ button(page.gallery.allLink.label, page.gallery.allLink.href, 'gallery__mobile-link', 'gallery') }}{% endif %}
  {% if page.gallery.booking %}{{ button(page.gallery.booking.label, page.gallery.booking.href, 'gallery__booking', 'primary') }}{% endif %}
</section>
{% include "components/gallery-modal/gallery-modal.njk" %}
