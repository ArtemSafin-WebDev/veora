<section class="gallery" id="gallery" data-gallery aria-labelledby="gallery-title">
  <div class="gallery__header">
    <h2 class="gallery__title" id="gallery-title">{{ page.gallery.title }}</h2>
    <span class="gallery__divider" aria-hidden="true"></span>
    <div class="gallery__controls">
      <a class="gallery__all-link" href="{{ page.gallery.allLink.href }}">{{ page.gallery.allLink.label }}</a>
      <div class="gallery__arrows">
        <button class="gallery__arrow gallery__arrow--prev" type="button" aria-label="Предыдущие фотографии">
          <svg class="gallery__arrow-icon gallery__arrow-icon--enabled" aria-hidden="true" focusable="false" viewBox="0 0 30 30"><use href="#icon-gallery-next"></use></svg>
          <svg class="gallery__arrow-icon gallery__arrow-icon--disabled" aria-hidden="true" focusable="false" viewBox="0 0 30 30"><use href="#icon-gallery-disabled"></use></svg>
        </button>
        <button class="gallery__arrow gallery__arrow--next" type="button" aria-label="Следующие фотографии">
          <svg class="gallery__arrow-icon gallery__arrow-icon--enabled" aria-hidden="true" focusable="false" viewBox="0 0 30 30"><use href="#icon-gallery-next"></use></svg>
          <svg class="gallery__arrow-icon gallery__arrow-icon--disabled" aria-hidden="true" focusable="false" viewBox="0 0 30 30"><use href="#icon-gallery-disabled"></use></svg>
        </button>
      </div>
    </div>
  </div>

  <div class="gallery__slider swiper">
    <div class="gallery__track swiper-wrapper">
      {% for card in page.gallery.items %}
        <div class="gallery__slide swiper-slide">
          {% include "components/gallery-card/gallery-card.njk" %}
        </div>
      {% endfor %}
    </div>
  </div>
  <a class="gallery__mobile-link" href="{{ page.gallery.allLink.href }}">{{ page.gallery.allLink.label }}</a>
</section>
