{% from "components/breadcrumbs/breadcrumbs.njk" import breadcrumbs %}
{% macro pageBanner(banner) %}
<section class="page-banner{% if banner.variant %} page-banner--{{ banner.variant }}{% endif %}" aria-labelledby="{{ banner.id }}-title">
  <picture class="page-banner__picture">
    {% if banner.mobileImage %}<source media="(max-width: 600px)" srcset="{{ banner.mobileImage }}" />{% endif %}
    <img class="page-banner__image" src="{{ banner.image }}" alt="{{ banner.imageAlt or '' }}" fetchpriority="high" />
  </picture>
  <div class="page-banner__shade" aria-hidden="true"></div>
  <div class="page-banner__container container">
    {{ breadcrumbs(banner.breadcrumbs, banner.breadcrumbsLabel) }}
    {% if banner.action %}
    <div class="page-banner__heading">
      <h1 class="page-banner__title" id="{{ banner.id }}-title">{{ banner.title }}</h1>
      {% if banner.action.modalId %}
      <button class="button button--{{ banner.action.variant or 'dark' }} page-banner__action" type="button" data-modal-open="{{ banner.action.modalId }}" aria-haspopup="dialog">{{ banner.action.label }}</button>
      {% elif banner.action.href %}
      <a class="button button--{{ banner.action.variant or 'dark' }} page-banner__action" href="{{ banner.action.href }}"{% if banner.action.upcomingLabel %} data-banner-archive data-upcoming-label="{{ banner.action.upcomingLabel }}"{% endif %}>{{ banner.action.label }}</a>
      {% else %}
      <button class="button button--{{ banner.action.variant or 'dark' }} page-banner__action" type="button">{{ banner.action.label }}</button>
      {% endif %}
    </div>
    {% else %}
    <h1 class="page-banner__title" id="{{ banner.id }}-title">{% if banner.mobileTitleLines %}<span class="page-banner__desktop-title">{{ banner.title }}</span><span class="page-banner__mobile-title">{% for line in banner.mobileTitleLines %}<span>{{ line }}</span>{% endfor %}</span>{% else %}{{ banner.title }}{% endif %}</h1>
    {% endif %}
  </div>
</section>
{% endmacro %}
