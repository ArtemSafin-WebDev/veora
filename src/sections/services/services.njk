{% from "components/icon/icon.njk" import icon %}
{% from "components/button/button.njk" import button %}
{% from "components/section-title/section-title.njk" import sectionTitle %}
<section class="services{% if page.services.variant %} services--{{ page.services.variant }}{% endif %} container" id="services" data-services aria-labelledby="services-title">
  <div class="services__header">
    <div class="services__ornament" aria-hidden="true">
      <span class="services__rule"></span>
      <span class="services__mark services__mark--desktop">{{ icon(page.services.brandMark or 'services-brand-mark', '', 13.1, 12.3) }}</span>
      <span class="services__mark services__mark--mobile">{{ icon(page.services.brandMarkMobile or 'services-brand-mark-mobile', '', 7.22518, 6.81231) }}</span>
      <span class="services__rule"></span>
    </div>
    {{ sectionTitle(page.services.title, 'services-title', 'services__title') }}
    <div class="services__tabs" role="tablist" aria-label="Категории услуг">
      {% for tab in page.services.tabs %}
        <button class="services__tab{% if loop.first %} services__tab--active{% endif %}" type="button" role="tab" id="services-tab-{{ tab.id }}" aria-controls="services-panel-{{ tab.id }}" aria-selected="{% if loop.first %}true{% else %}false{% endif %}" tabindex="{% if loop.first %}0{% else %}-1{% endif %}" data-services-tab="{{ tab.id }}">{{ tab.label }}</button>
      {% endfor %}
    </div>
  </div>

  {% for tab in page.services.tabs %}
    <div class="services__panel" id="services-panel-{{ tab.id }}" role="tabpanel" aria-labelledby="services-tab-{{ tab.id }}" tabindex="0"{% if not loop.first %} hidden{% endif %}>
      <div class="services__grid">
        {% for card in page.services.items %}
          {% if tab.id == 'all' or tab.id in card.categories %}
            {% include "components/service-card/service-card.njk" %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endfor %}

  {{ button(page.services.allLink.label, page.services.allLink.href, 'services__all-link', 'dark', page.services.variant == 'resort', page.services.variant == 'resort') }}
</section>
