<section class="contacts-map" aria-label="{{ page.map.label }}" data-contacts-map data-api-key="{{ page.map.apiKey }}" data-longitude="{{ page.map.coordinates[0] }}" data-latitude="{{ page.map.coordinates[1] }}" data-zoom="{{ page.map.zoom }}">
  <div class="contacts-map__container container">
    <div class="contacts-map__frame{% if page.map.route %} contacts-map__frame--route{% endif %}">
      <div class="contacts-map__canvas" data-map-canvas aria-label="{{ page.map.label }}"></div>
      <div class="contacts-map__fallback{% if page.map.previewImage %} contacts-map__fallback--preview{% endif %}" data-map-fallback>
        {% if page.map.previewImage %}<img class="contacts-map__preview" src="{{ page.map.previewImage }}" alt="{{ page.map.previewAlt }}" loading="lazy" />{% endif %}
        <p class="contacts-map__status" role="status" data-map-status data-loading-label="{{ page.map.loadingLabel }}" data-error-label="{{ page.map.errorLabel }}"></p>
        <a href="{{ page.map.href }}" target="_blank" rel="noopener noreferrer">{{ page.map.linkLabel }}</a>
      </div>
      {% if page.map.route %}<a class="button button--primary button--rounded button--compact contacts-map__route" href="{{ page.map.route.href }}" target="_blank" rel="noopener noreferrer">{{ page.map.route.label }}</a>{% endif %}
    </div>
  </div>
</section>
