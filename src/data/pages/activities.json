  "request": {
    "id": "activity-request-modal",
    "label": "Заявка на организацию мероприятия",
    "form": {
      "id": "activity-request",
      "title": "Оставить заявку",
      "description": "Укажите контакты и пожелания к мероприятию.",
      "action": null,
      "hiddenFields": [
        {
          "name": "activity_title",
          "value": ""
        }
      ],
      "fields": [
        {
          "name": "name",
          "label": "Ваше имя",
          "autocomplete": "given-name",
          "required": true,
          "maxLength": 100,
          "minLength": 2
        },
        {
          "name": "phone",
          "label": "Телефон",
          "autocomplete": "tel",
          "required": true,
          "mask": "phone",
          "inputMode": "tel",
          "pattern": "\\+7 \\([0-9]{3}\\) [0-9]{3}-[0-9]{2}-[0-9]{2}",
          "errorMessage": "Введите телефон полностью: +7 (999) 123-45-67."
        },
        {
          "name": "wishes",
          "label": "Пожелания к мероприятию",
          "maxLength": 1000
        }
      ],
      "consent": {
        "label": "Принимаю условия обработки персональных данных"
      },
      "submitLabel": "Оставить заявку"
    }
