  "contactsTransfer": {
    "form": {
      "id": "contacts-transfer-form",
      "title": "Заказать трансфер",
      "fields": [
        {
          "name": "name",
          "label": "Ваше имя",
          "autocomplete": "name",
          "required": true,
          "maxLength": 100
        },
        {
          "name": "phone",
          "type": "tel",
          "label": "Телефон",
          "autocomplete": "tel",
          "inputMode": "tel",
          "mask": "phone",
          "required": true,
          "pattern": "\\+7 \\([0-9]{3}\\) [0-9]{3}-[0-9]{2}-[0-9]{2}",
          "errorMessage": "Введите телефон полностью."
        },
        {
          "name": "time",
          "label": "Время",
          "inputMode": "numeric",
          "mask": "time",
          "required": true,
          "pattern": "([01][0-9]|2[0-3]):[0-5][0-9]",
          "errorMessage": "Введите время в формате ЧЧ:ММ от 00:00 до 23:59."
        },
        {
          "name": "date",
          "label": "Дата",
          "inputMode": "numeric",
          "mask": "date",
          "required": true,
          "pattern": "[0-9]{2}\\.[0-9]{2}\\.[0-9]{4}",
          "errorMessage": "Введите существующую дату в формате ДД.ММ.ГГГГ."
        },
        {
          "name": "passengers",
          "label": "Количество людей",
          "inputMode": "numeric",
          "pattern": "[1-9][0-9]{0,2}",
          "errorMessage": "Введите количество людей от 1 до 999.",
          "viewport": "desktop",
          "fullWidth": true
        },
        {
          "name": "car",
          "label": "Машина",
          "maxLength": 100,
          "viewport": "mobile"
        },
        {
          "name": "wishes",
          "label": "Пожелания",
          "maxLength": 1000,
          "fullWidth": true
        }
      ],
      "hiddenFields": [
        {
          "name": "request_type",
          "value": "transfer"
        },
        {
          "name": "resort",
          "value": "Южный"
        }
      ],
      "consent": {
        "label": "Принимаю условия",
        "link": {
          "label": "обработки персональных данных",
          "href": "/privacy/"
        }
      },
      "submitLabel": "Отправить"
    }
