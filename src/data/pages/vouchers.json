    "imageAlt": "Пробежка по загородной дорожке",
    "duration": "60 минут",
    "title": "Чистка лица гигиеническая аппаратная ультразвуковая на профессиональной косметике Selvert Thermal Швейцария",
    "description": "Мягкая косметологическая процедура, использующая высокочастотные звуковые волны (через скрабер-лопатку) для очищения кожи от ороговевших клеток, комедонов и себума, сопровождаемая использованием глубоко очищающих и ухаживающих профессиональных средств (гели, сыворотки, маски",
    "form": {
      "id": "voucher-request",
      "title": "Оставить заявку",
      "variant": "booking",
      "action": null,
      "hiddenFields": [
        {
          "name": "voucher_title",
          "value": ""
        },
        {
          "name": "service_title",
          "value": ""
        }
      ],
      "fields": [
        {
          "name": "name",
          "label": "Ваше имя",
          "autocomplete": "given-name",
          "required": true,
          "maxLength": 100,
          "minLength": 2,
          "pattern": "[\\p{L}\\p{M}][\\p{L}\\p{M}\\s’'\\-]*",
          "errorMessage": "Введите имя буквами, без цифр и специальных символов."
        },
        {
          "name": "phone",
          "label": "Телефон",
          "type": "text",
          "autocomplete": "tel",
          "required": true,
          "pattern": "\\+7 \\([0-9]{3}\\) [0-9]{3}-[0-9]{2}-[0-9]{2}",
          "maxLength": 18,
          "mask": "phone",
          "inputMode": "tel",
          "errorMessage": "Введите телефон полностью: +7 (999) 123-45-67."
        },
        {
          "name": "time",
          "label": "Время",
          "pattern": "([01][0-9]|2[0-3]):[0-5][0-9]",
          "maxLength": 5,
          "hint": "Время в формате ЧЧ:ММ, например 12:30",
          "mask": "time",
          "inputMode": "numeric",
          "errorMessage": "Введите время от 00:00 до 23:59."
        },
        {
          "name": "date",
          "label": "Дата",
          "pattern": "(0[1-9]|[12][0-9]|3[01])\\.(0[1-9]|1[0-2])\\.[0-9]{4}",
          "maxLength": 10,
          "hint": "Дата в формате ДД.ММ.ГГГГ, например 25.10.2026",
          "mask": "date",
          "inputMode": "numeric",
          "errorMessage": "Введите существующую дату в формате ДД.ММ.ГГГГ."
        },
        {
          "name": "wishes",
          "label": "Пожелания",
          "maxLength": 1000
        }
      ],
      "consent": {
        "label": "Принимаю условия обработки персональных данных"
      },
      "submitLabel": "Оставить заявку"
    }
